# LLM API Configuration
# Fill in with your own provider credentials. Leave empty to use basic training without LLM.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1500

# Tuning budget
TUNING_MAX_TRIALS=10
TUNING_PATIENCE=4
TUNING_MAX_LLM_CALLS=15
TUNING_WALL_TIME_SECONDS=900
TRAIN_TRIAL_TIMEOUT_SECONDS=180
TRAIN_N_JOBS=2

# Storage
APP_STORAGE_DIR=./storage
